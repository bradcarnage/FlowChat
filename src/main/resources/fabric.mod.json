{
  "schemaVersion": 1,
  "id": "flowchat",
  "version": "${version}",

  "name": "FlowChat",
  "description": "Regex-based chat message replacement with toast notifications, auto-responses, sound alerts, and value stacking.",
  "authors": [
    "bradcarnage"
  ],
  "contact": {
    "homepage": "https://github.com/bradcarnage/FlowChat",
    "sources": "https://github.com/bradcarnage/FlowChat"
  },

  "license": "GPL-3.0",
  "icon": "assets/flowchat/icon.png",

  "environment": "client",
  "entrypoints": {
    "client": [ "computer.brads.chatflow.FlowChat" ]
  },
  "mixins": [
    "flowchat.mixins.json"
  ],

  "depends": {
    "fabricloader": ">=0.15.0",
    "fabric": "*",
    "minecraft": "~1.21.4",
    "java": ">=21"
  },
  "suggests": {
    "modmenu": "*"
  }
}
