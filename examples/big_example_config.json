{
    "_comment": "FlowChat v2.1 — Big Example Config. Place as .minecraft/config/flowchat.json (client) or plugins/FlowChat/flowchat.json (server).",

    "antiAFK": {
        "afterSeconds": 240,
        "command": "/afk",
        "description": "Send /afk before the server kicks me for idling."
    },

    "voidFall": {
        "yLevel": -40,
        "command": "/spawn",
        "description": "Emergency teleport if I fall below Y=-40."
    },

    "incoming": [
        {
            "_section": "=== CHAT CLEANUP: Hide spam and noise ===",
            "description": "Suppress join/leave spam from lobby servers.",
            "pattern": "^(\\w+ (joined|left) the game|\\w+ has (joined|quit))\\.*$",
            "replacement": "pleasecancelthismessage",
            "toast": false,
            "server": ".*lobby.*|.*hub.*"
        },
        {
            "description": "Hide 'You are now AFK' and 'You are no longer AFK' messages.",
            "pattern": "^You are (now|no longer) AFK\\.?$",
            "replacement": "pleasecancelthismessage",
            "toast": false
        },
        {
            "description": "Remove TPA noise — I already know how to use /tpa.",
            "pattern": "^(To cancel this request, type /tpacancel\\.|Teleporting to .*\\.|Teleporting\\.\\.\\.|To teleport, type /tpaccept\\.|To deny this request, type /tpdeny\\.|This request will timeout after \\d+ seconds\\.)$",
            "replacement": "pleasecancelthismessage",
            "toast": false
        },
        {
            "description": "Kill pet callout spam.",
            "pattern": "^(\\w+) (comes to you|has been sent away|has already been sent away)\\.$",
            "replacement": "pleasecancelthismessage",
            "toast": false,
            "respond": "/petsendaway"
        },
        {
            "description": "Suppress 'now sitting / no longer sitting' from GSit or similar.",
            "pattern": "^You are no(w| longer) sitting!$",
            "replacement": "pleasecancelthismessage",
            "toast": false
        },
        {
            "description": "Hide Pong! response from /ping (suppress anti-AFK echo).",
            "pattern": "^Pong!$",
            "replacement": "pleasecancelthismessage",
            "toast": false
        },

        {
            "_section": "=== TOASTS: Move noisy messages out of chat into popups ===",
            "description": "Admin shop purchase — show as toast instead of chat line.",
            "pattern": "^\\[Shop\\] (.*)$",
            "replacement": "$1",
            "toast": true,
            "sound": "pop",
            "notifyStyle": "toast"
        },
        {
            "description": "WorldGuard region enter/leave (**region name**) — toast with bell sound.",
            "pattern": "^\\*\\* (.*) \\*\\*$",
            "replacement": "§b§l$1",
            "toast": true,
            "sound": "bell",
            "notifyStyle": "actionbar"
        },
        {
            "description": "Locked chest message — bold red toast.",
            "pattern": "^[\\w ]+locked with a magical spell$",
            "replacement": "§4§l$0",
            "toast": true,
            "sound": "anvil"
        },
        {
            "description": "WorldGuard protection denial — toast with warning color.",
            "pattern": "^Hey! Sorry, but you can't (.*) here\\.$",
            "replacement": "§4§lYou can't $1.",
            "toast": true,
            "sound": "click"
        },
        {
            "description": "EpicRename success — green bold toast, no chat spam when renaming stacks.",
            "pattern": "^\\[EpicRename\\] Renamed the item successfully\\.$",
            "replacement": "§a§lRenamed!",
            "toast": true,
            "notifyStyle": "advancement"
        },
        {
            "description": "Destination obstructed — teleport failed, show bright red toast.",
            "pattern": "^Your destination is obstructed!$",
            "replacement": "§c§lDestination blocked!",
            "toast": true,
            "sound": "anvil"
        },
        {
            "description": "Auction countdown — flashy toast for time pressure.",
            "pattern": "^\\[Auction\\] (\\d+ seconds left)\\.$",
            "replacement": "§4§klllll §7§l[§1§lAuction§7§l]§1§l $1 §4§klllll",
            "toast": true,
            "sound": "bell",
            "notifyStyle": "toast"
        },
        {
            "description": "Warp cooldown notices — actionbar so they don't clog chat.",
            "pattern": "^You (must wait|can't warp for) (\\d+) (seconds?|minutes?).*$",
            "replacement": "§eWarp cooldown: §c$2 $3",
            "toast": true,
            "notifyStyle": "actionbar"
        },

        {
            "_section": "=== CHAT FORMATTING: Make messages prettier ===",
            "description": "MCMMO level-up — reformat and toast.",
            "pattern": "^(\\w+) increased to (\\d+)\\.$",
            "replacement": "§6§l$1 §f→ §a§lLv.$2",
            "toast": true,
            "sound": "levelup",
            "notifyStyle": "advancement"
        },
        {
            "description": "Staff messages in [brackets] get highlighted yellow.",
            "pattern": "^\\[Staff\\] (.+)$",
            "replacement": "§e§l[STAFF] §r§e$1"
        },
        {
            "description": "Private messages get a colored prefix.",
            "pattern": "^(\\w+) whispers to you: (.+)$",
            "replacement": "§d§l[PM] §r§d$1: §f$2",
            "sound": "note"
        },

        {
            "_section": "=== VALUE STACKING: Combine rapid numeric messages ===",
            "description": "Stack shop sale messages: '5 You sold 64 Iron Block for $69.42' gets combined over 4 seconds.",
            "pattern": "^(\\d+) You sold (\\d+) (.*?) for \\$([\\d\\.]+)\\.$",
            "replacement": "§aSold §l$^2§r§a $3 for §l$$$^4§r§a ($^i sales)",
            "toast": true,
            "sound": "pop",
            "valuestack": {
                "ignore_diffs": [1],
                "stack_values": [2, 4],
                "expire_after": 4,
                "seperate_float_with": "."
            }
        },
        {
            "description": "Stack XP gain messages over 6 seconds: '+150 XP (Mining)'.",
            "pattern": "^\\+(\\d+) XP \\((\\w+)\\)$",
            "replacement": "§b+$^1 XP §7($2) §8x$^i",
            "toast": true,
            "notifyStyle": "actionbar",
            "valuestack": {
                "stack_values": [1],
                "expire_after": 6
            }
        },
        {
            "description": "Stack money gain: 'You earned $X' over 5 seconds.",
            "pattern": "^You earned \\$(\\d+\\.?\\d*)\\.$",
            "replacement": "§a+$$$^1 §8(x$^i)",
            "toast": true,
            "notifyStyle": "actionbar",
            "valuestack": {
                "stack_values": [1],
                "expire_after": 5,
                "seperate_float_with": "."
            }
        },

        {
            "_section": "=== AREA SHOP: Rent management ===",
            "description": "AreaShop rent info — clean up and toast.",
            "pattern": "^\\[AreaShop\\] (\\w+) is rented by (\\S+) until (\\d+) (\\w{1,3})\\w* (\\d+) (\\d+:\\d+)\\.$",
            "replacement": "§a§l$2§r§e rents this until §a$6 §a§l$3$4$5",
            "toast": true
        },
        {
            "description": "AreaShop — auto-refresh MY own rent (change 'YourName' to your username).",
            "pattern": "^\\[AreaShop\\] (\\w+) is rented by (YourName) until (\\d+) (\\w{1,3})\\w* (\\d+) (\\d+:\\d+)\\.$",
            "replacement": "§a§l$2§r§e rents this until §a$6 §a§l$3$4$5",
            "toast": true,
            "respond": "/as rent $1"
        },
        {
            "description": "AreaShop rent extended confirmation.",
            "pattern": "^\\[AreaShop\\] You extended your rent of (\\S+) until (\\d+) (\\w{1,3})\\w* (\\d+) (\\d+:\\d+).*$",
            "replacement": "§e§lRent extended until §a$5 §a§l$2$3$4",
            "toast": true,
            "sound": "ding"
        },

        {
            "_section": "=== AUTO-RESPONSES: Automatic reactions to messages ===",
            "description": "Auto-accept TPA from trusted friends (add names separated by |).",
            "pattern": "^(FriendName1|FriendName2|DiscordApp) has requested to teleport to you\\.$",
            "replacement": "$0",
            "toast": false,
            "respond": "/tpaccept",
            "sound": "pop"
        },
        {
            "description": "Ping-pong — respond 'pong!' when anyone says 'ping' in chat.",
            "pattern": ".*> ping$",
            "replacement": "$0",
            "toast": false,
            "respond": "pong!"
        },
        {
            "description": "Auto /bottle get max when XP bottle fails.",
            "pattern": "^You dont have enough exp$",
            "replacement": "pleasecancelthismessage",
            "toast": false,
            "respond": "/bottle get max"
        },
        {
            "description": "Multi-response: send two commands when a vote reward arrives.",
            "pattern": "^\\[Vote\\] Thanks for voting, (\\w+)!$",
            "replacement": "§a§lVote reward received!",
            "toast": true,
            "sound": "levelup",
            "respond": ["/vote claim", "/msg $1 thanks for the vote reward!"]
        },

        {
            "_section": "=== SERVER-SPECIFIC RULES ===",
            "description": "Hypixel: Reformat BedWars kill feed into compact toast.",
            "pattern": "^(\\w+) was (killed|shot|knocked) by (\\w+).*$",
            "replacement": "§c$3 §7→ §4$1",
            "toast": true,
            "notifyStyle": "actionbar",
            "server": ".*hypixel\\.net.*"
        },
        {
            "description": "Only on mc.myserver.com: Suppress MOTD repeat lines.",
            "pattern": "^Welcome to MyServer! Type /help.*$",
            "replacement": "pleasecancelthismessage",
            "toast": false,
            "server": "^mc\\.myserver\\.com(:\\d+)?$"
        },
        {
            "description": "Singleplayer only: Show coordinates as actionbar when typing /pos.",
            "pattern": "^Block: (-?\\d+), (-?\\d+), (-?\\d+)$",
            "replacement": "§e$1, $2, $3",
            "toast": true,
            "notifyStyle": "actionbar",
            "server": "singleplayer"
        },

        {
            "_section": "=== COLOR-AWARE MATCHING (Feature #3) ===",
            "description": "Match a message that has a §c (red) color code — only fires if the server actually sent red text.",
            "pattern": "§c(WARNING|DANGER|ALERT)",
            "replacement": "§4§l⚠ $1 ⚠",
            "toast": true,
            "sound": "anvil",
            "colorAware": true
        },

        {
            "_section": "=== JSON MATCHING (Feature #6) ===",
            "description": "Match raw JSON component — detect hover-text clickable messages from plugins (the plain text may look normal but the JSON has click actions).",
            "pattern": "\"clickEvent\".*\"open_url\"",
            "replacement": "§e[Link] §r$0",
            "matchJson": true
        },

        {
            "_section": "=== DYNAMIC TAGS IN REPLACEMENTS ===",
            "description": "Show server info in a reformatted MOTD line.",
            "pattern": "^Welcome, (\\w+)!$",
            "replacement": "§6Welcome §l$1§r§6! §7({servername} @ {serverip}) §8[{time}]"
        },
        {
            "description": "Personalized death message — insert your username via tag.",
            "pattern": "^(\\w+) was slain by (.+)$",
            "replacement": "§c☠ $1 §7was killed by §c$2 §8[{time}]"
        }
    ],

    "outgoing": [
        {
            "_section": "=== OUTGOING: Modify messages BEFORE they're sent ===",
            "description": "Color all my chat green on a specific server — exclude commands (/) and staff chat (#).",
            "pattern": "^[^#/].*",
            "replacement": "&a&l$0",
            "server": "^mc\\.exampleserver\\.com(:\\d+)?$"
        },
        {
            "description": "Quick alias: /b → /bottle get 64",
            "pattern": "^/b$",
            "replacement": "/bottle get 64"
        },
        {
            "description": "Quick alias: /h → /home",
            "pattern": "^/h$",
            "replacement": "/home"
        },
        {
            "description": "Quick alias: /s → /spawn",
            "pattern": "^/s$",
            "replacement": "/spawn"
        },
        {
            "description": "Quick alias: /w <name> → /msg <name> (whisper shorthand).",
            "pattern": "^/w (\\w+) (.+)$",
            "replacement": "/msg $1 $2"
        },
        {
            "description": "Auto-correct common typo: 'teh' → 'the' in outgoing chat.",
            "pattern": "\\bteh\\b",
            "replacement": "the"
        },
        {
            "description": "Convert :shrug: emoticon to the actual kaomoji.",
            "pattern": ":shrug:",
            "replacement": "¯\\\\_(ツ)_/¯"
        },
        {
            "description": "Convert :tableflip: to the emoticon.",
            "pattern": ":tableflip:",
            "replacement": "(╯°□°)╯︵ ┻━┻"
        },
        {
            "description": "Singleplayer testing — intercept 'test' locally and toast the result without sending.",
            "pattern": "t(est)",
            "replacement": "this is the b$1",
            "toast": true,
            "server": "singleplayer"
        },
        {
            "description": "Block accidental /stop on any server (outgoing rule cancels the command).",
            "pattern": "^/stop$",
            "replacement": "pleasecancelthismessage",
            "toast": false
        }
    ]
}
